data: {"id":"6c9cf6417348430c863c1604d847bff7","object":"chat.completion.chunk","created":1777485224,"model":"Qwen3.5-397B-A17B-GPTQ-Int4","choices":[{"index":0,"delta":{"role":null,"content":null,"reasoning_content":null,"tool_calls":[{"id":null,"index":0,"type":"function","function":{"name":null,"arguments":", \"changes\": \"# coding:utf-8\\n# pylint: disable=C0301,W0613\\n\\\"\\\"\\\"\\ncoverage test for autocell, deployed on jn-cell08\\nmode: routine commit local\\ntrigger by jenkins\\n\\\"\\\"\\\"\\n\\nimport os\\nimport sys\\nimport logging\\n\\n# 配置日志输出\\nlogging.basicConfig(\\n    level=logging.INFO,\\n    format='%(asctime)s - %(levelname)s - %(message)s'\\n)\\nlogger = logging.getLogger(__name__)\\n\\nMODE = os.environ.get(\\\"MODE\\\", \\\"routine\\\")\\n\\n\\nclass BaseCoverageJob:\\n    \\\"\\\"\\\"覆盖率任务基类\\\"\\\"\\\"\\n    \\n    def __init__(self, mode):\\n        self.mode = mode\\n    \\n    def execute(self):\\n        \\\"\\\"\\\"执行覆盖率任务\\\"\\\"\\\"\\n        raise NotImplementedError(\\\"子类必须实现 execute 方法\\\")\\n    \\n    def validate(self):\\n        \\\"\\\"\\\"验证环境配置\\\"\\\"\\\"\\n        logger.info(f\\\"验证 {self.mode} 模式环境配置\\\")\\n        return True\\n\\n\\nclass BaseSummaryJob:\\n    \\\"\\\"\\\"覆盖率汇总任务基类\\\"\\\"\\\"\\n    \\n    def __init__(self, mode):\\n        self.mode = mode\\n    \\n    def summarize(self):\\n        \\\"\\\"\\\"生成覆盖率汇总报告\\\"\\\"\\\"\\n        raise NotImplementedError(\\\"子类必须实现 summarize 方法\\\")\\n    \\n    def validate(self):\\n        \\\"\\\"\\\"验证汇总条件\\\"\\\"\\\"\\n        logger.info(f\\\"验证 {self.mode} 模式汇总条件\\\")\\n        return True\\n\\n\\nclass RoutineCoverageJob(BaseCoverageJob):\\n    \\\"\\\"\\\"例行覆盖率任务\\\"\\\"\\\"\\n    \\n    def __init__(self):\\n        super().__init__(\\\"routine\\\")\\n    \\n    def execute(self):\\n        if not self.validate():\\n            logger.error(\\\"例行覆盖率任务验证失败\\\")\\n            return False\\n        logger.info(\\\"routine coverage\\\")\\n        print(\\\"routine coverage\\\")\\n        return True\\n\\n\\nclass CommitCoverageJob(BaseCoverageJob):\\n    \\\"\\\"\\\"提交覆盖率任务\\\"\\\"\\\"\\n    \\n    def __init__(self):\\n        super().__init__(\\\"commit\\\")\\n    \\n    def execute(self):\\n        if not self.validate():\\n            logger.error(\\\"提交覆盖率任务验证失败\\\")\\n            return False\\n        logger.info(\\\"commit coverage\\\")\\n        print(\\\"commit coverage\\\")\\n        return True\\n\\n\\nclass LocalCoverageJob(BaseCoverageJob):\\n    \\\"\\\"\\\"本地覆盖率任务\\\"\\\"\\\"\\n    \\n    def __init__(self):\\n        super().__init__(\\\"local\\\")\\n    \\n    def execute(self):\\n        if not self.validate():\\n            logger.error(\\\"本地覆盖率任务验证失败\\\")\\n            return False\\n        logger.info(\\\"local coverage\\\")\\n        print(\\\"local coverage\\\")\\n        return True\\n\\n\\nclass RoutineSummaryJob(BaseSummaryJob):\\n    \\\"\\\"\\\"例行覆盖率汇总任务\\\"\\\"\\\"\\n    \\n    def __init__(self):\\n        super().__init__(\\\"routine\\\")\\n    \\n    def summarize(self):\\n        if not self.validate():\\n            logger.error(\\\"例行覆盖率汇总验证失败\\\")\\n            return False\\n        logger.info(\\\"routine coverage summary\\\")\\n        return True\\n\\n\\nclass CommitSummaryJob(BaseSummaryJob):\\n    \\\"\\\"\\\"提交覆盖率汇总任务\\\"\\\"\\\"\\n    \\n    def __init__(self):\\n        super().__init__(\\\"commit\\\")\\n    \\n    def summarize(self):\\n        if not self.validate():\\n            logger.error(\\\"提交覆盖率汇总验证失败\\\")\\n            return False\\n        logger.info(\\\"commit coverage summary\\\")\\n        return True\\n\\n\\nclass LocalSummaryJob(BaseSummaryJob):\\n    \\\"\\\"\\\"本地覆盖率汇总任务\\\"\\\"\\\"\\n    \\n    def __init__(self):\\n        super().__init__(\\\"local\\\")\\n    \\n    def summarize(self):\\n        if not self.validate():\\n            logger.error(\\\"本地覆盖率汇总验证失败\\\")\\n            return False\\n        logger.info(\\\"local coverage summary\\\")\\n        return True\\n\\n\\ndef get_coverage_job(mode):\\n    \\\"\\\"\\\"根据模式获取覆盖率任务实例\\\"\\\"\\\"\\n    job_map = {\\n        \\\"routine\\\": RoutineCoverageJob,\\n        \\\"commit\\\": CommitCoverageJob,\\n        \\\"local\\\": LocalCoverageJob\\n    }\\n    \\n    if mode not in job_map:\\n        logger.error(f\\\"未知的模式: {mode}\\\")\\n        return None\\n    \\n    return job_map[mode]()\\n\\n\\ndef get_summary_job(mode):\\n    \\\"\\\"\\\"根据模式获取汇总任务实例\\\"\\\"\\\"\\n    summary_map = {\\n        \\\"routine\\\": RoutineSummaryJob,\\n        \\\"commit\\\": CommitSummaryJob,\\n        \\\"local\\\": LocalSummaryJob\\n    }\\n    \\n    if mode not in summary_map:\\n        logger.error(f\\\"未知的模式: {mode}\\\")\\n        return None\\n    \\n    return summary_map[mode]()\\n\\n\\ndef main():\\n    \\\"\\\"\\\"主函数入口\\\"\\\"\\\"\\n    try:\\n        logger.info(f\\\"当前模式: {MODE}\\\")\\n        \\n        # 执行覆盖率任务\\n        coverage_job = get_coverage_job(MODE)\\n        if coverage_job is None:\\n            print(\\\"unknown mode\\\")\\n            return 1\\n        \\n        if not coverage_job.execute():\\n            return 1\\n        \\n        # 执行汇总任务\\n        summary_job = get_summary_job(MODE)\\n        if summary_job:\\n            summary_job.summarize()\\n        \\n        return 0\\n    \\n    except Exception as e:\\n        logger.error(f\\\"执行失败: {str(e)}\\\")\\n        return 1\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\""}}]},"logprobs":null,"finish_reason":null,"matched_stop":null}],"usage":null}

